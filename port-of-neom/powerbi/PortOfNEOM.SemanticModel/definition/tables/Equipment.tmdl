	partition Equipment = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblEquipment",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"EquipmentID", "Equipment", "TypeCode", "Units", "Supplier", "Technology", "SourceID"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"EquipmentID", type text}, {"Equipment", type text}, {"TypeCode", type text}, {"Units", Int64.Type}, {"Supplier", type text}, {"Technology", type text}, {"SourceID", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
