	partition PortProfile = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblPortProfile",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"ProfileID", "Category", "Attribute", "Value", "NumericValue", "Unit", "SourceID", "Note"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"ProfileID", type text}, {"Category", type text}, {"Attribute", type text}, {"Value", type text}, {"NumericValue", type number}, {"Unit", type text}, {"SourceID", type text}, {"Note", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
