table PortProfile
	lineageTag: e31bd868-f6f5-5695-a7ba-86afe190a950

	measure 'Quay Length (m)' = CALCULATE(MAX(PortProfile[NumericValue]), PortProfile[ProfileID] = "P04")
		formatString: #,##0
		lineageTag: caca96a9-6281-5629-a862-b484118ee279

	measure 'Berths' = CALCULATE(MAX(PortProfile[NumericValue]), PortProfile[ProfileID] = "P05")
		formatString: 0
		lineageTag: ba76e95f-3e73-54e2-8d5a-ae283daf984d

	measure 'Depth (m)' = CALCULATE(MAX(PortProfile[NumericValue]), PortProfile[ProfileID] = "P06")
		formatString: 0.0
		lineageTag: 705b4655-0427-55ea-9a1a-9c1db667a43e

	measure 'Saudi Port Volume (TEU)' = CALCULATE(MAX(PortProfile[NumericValue]), PortProfile[ProfileID] = "P13")
		formatString: #,##0
		lineageTag: 7fa70b24-9d93-55ad-be62-265aff58cf75

	measure 'Terminal 1 Status' = CALCULATE(MAX(PortProfile[Value]), PortProfile[ProfileID] = "P03")
		lineageTag: f4bf3de6-2998-5331-8bce-23dda8b3c27f

