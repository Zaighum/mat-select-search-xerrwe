	partition Calendar = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblCalendar",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"Date", "Year", "Quarter", "MonthNo", "MonthName", "YearMonth"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"MonthNo", Int64.Type}, {"MonthName", type text}, {"YearMonth", type text}}, "en-US")
				in
				    Typed

