table VesselCalls
	lineageTag: 055d83b4-087a-597c-a897-64c827130058

	measure 'Avg Calls per Month' = SUM(VesselCalls[AvgCallsPerMonth])
		formatString: 0.0
		lineageTag: 10f668ef-d672-5ccb-92e9-7668070527dc

	measure 'RoRo Calls per Month (Pre-war)' = CALCULATE([Avg Calls per Month], VesselCalls[CallID] = "V01")
		formatString: 0.0
		lineageTag: 653b82a3-f2b9-506a-a304-1d3a05a49682

	measure 'RoRo Calls (Sep 2026)' = CALCULATE([Avg Calls per Month], VesselCalls[CallID] = "V02")
		formatString: 0
		lineageTag: ee90422a-5d3c-5d71-bc0f-919736a5fa11

	measure 'RoRo Change vs Pre-war' = DIVIDE([RoRo Calls (Sep 2026)], [RoRo Calls per Month (Pre-war)]) - 1
		formatString: 0%
		lineageTag: 442c1bef-e901-545c-8d77-ec5fa6ab08bf

