	partition VesselCalls = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblVesselCalls",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"CallID", "VesselType", "PeriodGroup", "PeriodDetail", "Calls", "Months", "StatedAvgPerMonth", "SourceID", "Note", "AvgCallsPerMonth"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"CallID", type text}, {"VesselType", type text}, {"PeriodGroup", type text}, {"PeriodDetail", type text}, {"Calls", Int64.Type}, {"Months", Int64.Type}, {"StatedAvgPerMonth", type number}, {"SourceID", type text}, {"Note", type text}, {"AvgCallsPerMonth", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
