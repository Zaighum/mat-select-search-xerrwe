	partition Commercial = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblCommercial",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"RevenueID", "Month", "CustomerID", "CargoType", "Volume", "AttributedCalls", "Tonnes", "GrossHandlingSAR", "DiscountSAR", "MarineRevenueSAR", "StorageRevenueSAR", "NetRevenueSAR"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"RevenueID", type text}, {"Month", type date}, {"CustomerID", type text}, {"CargoType", type text}, {"Volume", type number}, {"AttributedCalls", type number}, {"Tonnes", type number}, {"GrossHandlingSAR", type number}, {"DiscountSAR", type number}, {"MarineRevenueSAR", type number}, {"StorageRevenueSAR", type number}, {"NetRevenueSAR", type number}}, "en-US")
