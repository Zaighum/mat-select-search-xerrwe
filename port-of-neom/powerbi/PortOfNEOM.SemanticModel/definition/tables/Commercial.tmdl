table Commercial
	lineageTag: 1575ebcd-017b-580b-a120-fb3657ff420a

	measure 'Net Revenue (SAR m)' = SUM(Commercial[NetRevenueSAR]) / 1000000
		formatString: #,##0.0
		lineageTag: 4b95dd8e-35a1-507c-b9ea-5e4b2bc0576b

	measure 'Handling Revenue (SAR m)' = (SUM(Commercial[GrossHandlingSAR]) - SUM(Commercial[DiscountSAR])) / 1000000
		formatString: #,##0.0
		lineageTag: 469ae123-06b6-58a4-94d5-0579029ff382

	measure 'Marine Revenue (SAR m)' = SUM(Commercial[MarineRevenueSAR]) / 1000000
		formatString: #,##0.0
		lineageTag: 1be92458-e0b4-5643-886a-9979cbb80746

	measure 'Storage Revenue (SAR m)' = SUM(Commercial[StorageRevenueSAR]) / 1000000
		formatString: #,##0.0
		lineageTag: c7854ac5-6cbb-5f7b-935f-429e8b6de4dc

	measure 'Discounts (SAR m)' = SUM(Commercial[DiscountSAR]) / 1000000
		formatString: #,##0.0
		lineageTag: 3a22f329-b794-51a9-b4e9-3efe14a54801

	measure 'Customer Tonnes (k)' = SUM(Commercial[Tonnes]) / 1000
		formatString: #,##0
		lineageTag: 76a22b79-8dd5-5d22-bef6-4ea03804ba55

	measure 'Revenue per Tonne (SAR)' = DIVIDE(SUM(Commercial[NetRevenueSAR]), SUM(Commercial[Tonnes]))
		formatString: 0.0
		lineageTag: eeed17ab-e645-5991-8d36-d2619578f91c

	measure 'Revenue Share' = DIVIDE([Net Revenue (SAR m)], CALCULATE([Net Revenue (SAR m)], ALLSELECTED(Customers)))
		formatString: 0.0%
		lineageTag: f18853f1-1ff0-514b-bedd-d18c8f66a5db

	measure 'Active Customers' = DISTINCTCOUNT(Commercial[CustomerID])
		formatString: 0
		lineageTag: 5dff0a81-24f1-52c4-93ba-81b18db0644a

