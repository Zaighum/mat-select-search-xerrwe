	column AmountSAR
		dataType: double
		lineageTag: 70f5e66c-8141-5d52-983b-f31d2c53987c
		summarizeBy: sum
		sourceColumn: AmountSAR

		annotation SummarizationSetBy = Automatic

	partition Finance = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblFinance",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"FinanceID", "Month", "AccountID", "Scenario", "AmountSAR"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"FinanceID", type text}, {"Month", type date}, {"AccountID", type text}, {"Scenario", type text}, {"AmountSAR", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
