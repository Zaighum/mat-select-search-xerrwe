table Finance
	lineageTag: d95598d0-ac16-53a4-b41e-307ba7edd110

	measure 'Actual (SAR m)' = CALCULATE(SUM(Finance[AmountSAR]), Finance[Scenario] = "Actual") / 1000000
		formatString: #,##0.0
		lineageTag: ff55a491-37e0-5f1d-8ffd-922d9c1eddf3

	measure 'Budget (SAR m)' = CALCULATE(SUM(Finance[AmountSAR]), Finance[Scenario] = "Budget") / 1000000
		formatString: #,##0.0
		lineageTag: f5894387-b25d-58c6-b90d-798cc8a65b78

	measure 'Variance (SAR m)' = [Actual (SAR m)] - [Budget (SAR m)]
		formatString: #,##0.0;-#,##0.0
		lineageTag: 80832c0a-1097-5b05-8bfa-55e5cc97d319

	measure 'Revenue (SAR m)' = CALCULATE([Actual (SAR m)], Accounts[Category] = "Revenue")
		formatString: #,##0.0
		lineageTag: bba676ef-d34d-5f2d-bf8f-06ab75e6b083

	measure 'Budget Revenue (SAR m)' = CALCULATE([Budget (SAR m)], Accounts[Category] = "Revenue")
		formatString: #,##0.0
		lineageTag: 8c7c4cfa-564f-5bfb-b1e3-8f331239656f

	measure 'Revenue vs Budget %' = DIVIDE([Revenue (SAR m)] - [Budget Revenue (SAR m)], [Budget Revenue (SAR m)])
		formatString: 0.0%
		lineageTag: d2d65a7e-fda3-5e69-b381-99025f45f158

	measure 'Opex (SAR m)' = CALCULATE([Actual (SAR m)], Accounts[Category] = "Opex")
		formatString: #,##0.0
		lineageTag: 369da61f-4a29-5468-8353-ed673693e135

	measure 'Budget Opex (SAR m)' = CALCULATE([Budget (SAR m)], Accounts[Category] = "Opex")
		formatString: #,##0.0
		lineageTag: e02571bf-2270-593b-adea-547af9828aa7

	measure 'EBITDA (SAR m)' = [Revenue (SAR m)] - [Opex (SAR m)]
		formatString: #,##0.0;-#,##0.0
		lineageTag: 17fab761-35d1-5e1a-8ce6-d11a9b609b6d

	measure 'Budget EBITDA (SAR m)' = [Budget Revenue (SAR m)] - [Budget Opex (SAR m)]
		formatString: #,##0.0;-#,##0.0
		lineageTag: 1854ff9c-45cc-515b-a6df-80420fb1d714

	measure 'EBITDA Margin' = DIVIDE([EBITDA (SAR m)], [Revenue (SAR m)])
		formatString: 0.0%
		lineageTag: 8b859582-e6e2-5478-b4ac-792fb30dc6bb

	measure 'Depreciation (SAR m)' = CALCULATE([Actual (SAR m)], Accounts[Category] = "Depreciation")
		formatString: #,##0.0
		lineageTag: 5a6c8100-2a56-5969-999f-23b352daa7db

	measure 'EBIT (SAR m)' = [EBITDA (SAR m)] - [Depreciation (SAR m)]
		formatString: #,##0.0;-#,##0.0
		lineageTag: f9efb7d4-bf39-5c7f-aba7-242f10223382

	column FinanceID
		dataType: string
		lineageTag: 77e84ebf-6e1a-5014-a172-81a5d752a459
