	partition Investment = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblInvestment",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"InvestmentID", "Statement", "StatementYear", "AmountSARbn", "SourceID", "Note", "AmountUSDbn"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"InvestmentID", type text}, {"Statement", type text}, {"StatementYear", Int64.Type}, {"AmountSARbn", type number}, {"SourceID", type text}, {"Note", type text}, {"AmountUSDbn", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
