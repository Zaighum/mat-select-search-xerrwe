	partition OpsKPI = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblOpsKPI",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"Month", "Headcount", "AnchorageWaitHrs", "CraneMovesPerHour", "TruckTurnMin", "EquipmentAvailability", "LostTimeInjuries", "BerthHours", "VesselCalls", "BerthOccupancy", "ManHours"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"Month", type date}, {"Headcount", Int64.Type}, {"AnchorageWaitHrs", type number}, {"CraneMovesPerHour", type number}, {"TruckTurnMin", type number}, {"EquipmentAvailability", type number}, {"LostTimeInjuries", Int64.Type}, {"BerthHours", type number}, {"VesselCalls", Int64.Type}, {"BerthOccupancy", type number}, {"ManHours", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
