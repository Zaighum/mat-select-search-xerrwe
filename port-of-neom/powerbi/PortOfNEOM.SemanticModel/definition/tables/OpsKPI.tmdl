table OpsKPI
	lineageTag: 7e34c353-aa32-5d18-a7f8-76d737f7ad73

	measure 'Berth Occupancy' = AVERAGE(OpsKPI[BerthOccupancy])
		formatString: 0.0%
		lineageTag: bf2f9dae-eaa9-5bad-8e49-7ba06f76d5df

	measure 'Crane Moves per Hour' = AVERAGE(OpsKPI[CraneMovesPerHour])
		formatString: 0.0
		lineageTag: 5aca02c8-ec36-5047-974a-f3f50670854b

	measure 'Truck Turn (min)' = AVERAGE(OpsKPI[TruckTurnMin])
		formatString: 0.0
		lineageTag: ae0025ab-606d-5d26-b923-d9c9ac822a1c

	measure 'Anchorage Wait (hrs)' = AVERAGE(OpsKPI[AnchorageWaitHrs])
		formatString: 0.0
		lineageTag: 313f3a84-5fed-5383-9e85-4ce57b498c89

	measure 'Equipment Availability' = AVERAGE(OpsKPI[EquipmentAvailability])
		formatString: 0.0%
		lineageTag: 98bec879-26db-5d8d-a274-803f96450726

	measure 'Lost Time Injuries' = SUM(OpsKPI[LostTimeInjuries])
		formatString: 0
		lineageTag: 8e953456-1ac3-5f74-8a88-505ab11f2e59

	measure 'LTIFR' = DIVIDE(SUM(OpsKPI[LostTimeInjuries]) * 1000000, SUM(OpsKPI[ManHours]))
		formatString: 0.00
		lineageTag: b299b285-8933-5f6b-b3fa-31a82a584495

	measure 'Avg Headcount' = AVERAGE(OpsKPI[Headcount])
		formatString: #,##0
		lineageTag: 8eadd4e9-cbab-510e-a635-dd9d7db5f40a

