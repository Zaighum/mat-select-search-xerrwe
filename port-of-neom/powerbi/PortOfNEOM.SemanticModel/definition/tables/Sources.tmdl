	partition Sources = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblSources",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"SourceID", "Publisher", "Title", "Published", "URL", "Note"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"SourceID", type text}, {"Publisher", type text}, {"Title", type text}, {"Published", type text}, {"URL", type text}, {"Note", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
