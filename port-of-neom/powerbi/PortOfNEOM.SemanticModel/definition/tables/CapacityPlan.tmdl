		annotation SummarizationSetBy = Automatic

	column Note
		dataType: string
		lineageTag: 96c05ff0-047e-5473-a5e0-b685732a9528
		summarizeBy: none
		sourceColumn: Note

		annotation SummarizationSetBy = Automatic

	column ShareOfSaudiTEU
		dataType: double
		lineageTag: a91bdf2a-00d2-58b6-bdaf-f2732ef87170
		summarizeBy: none
		sourceColumn: ShareOfSaudiTEU

		annotation SummarizationSetBy = Automatic

	partition CapacityPlan = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ExcelFilePath), null, true),
				    Data = Source{[Item="tblCapacityPlan",Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Data, {"CapacityID", "StatementYear", "Milestone", "TargetYear", "CapacityTEU", "PlanStatus", "SourceID", "Note", "ShareOfSaudiTEU"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"CapacityID", type text}, {"StatementYear", Int64.Type}, {"Milestone", type text}, {"TargetYear", Int64.Type}, {"CapacityTEU", type number}, {"PlanStatus", type text}, {"SourceID", type text}, {"Note", type text}, {"ShareOfSaudiTEU", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
