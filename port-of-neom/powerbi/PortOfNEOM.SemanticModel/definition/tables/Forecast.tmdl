		lineageTag: a0d8327c-d803-57da-984c-954f97e8c619

	measure 'Base 2031 EBITDA Margin' = CALCULATE([Forecast EBITDA Margin], Forecast[Scenario] = "Base", Forecast[Year] = 2031)
		formatString: 0.0%
		lineageTag: d819e77b-cad0-5d89-a044-5b3bcb871864

