		lineageTag: 85b911a5-d030-5727-b607-706b09aff0a7

	measure 'Base 2031 Revenue (SAR m)' = CALCULATE([Forecast Revenue (SAR m)], Forecast[Scenario] = "Base", Forecast[Year] = 2031)
