table Forecast
	lineageTag: f0bec9a6-db97-5333-ab84-e7882ae7b103

	measure 'Forecast TEU' = SUM(Forecast[ContainerTEU])
		formatString: #,##0
		lineageTag: 768b6717-cdd8-5182-9a4a-13eb0aadfaac

	measure 'Forecast Revenue (SAR m)' = SUM(Forecast[RevenueSARm])
		formatString: #,##0
		lineageTag: da42f326-f3e5-55c8-bdb5-24d5e9dbf742

	measure 'Forecast Opex (SAR m)' = SUM(Forecast[OpexSARm])
		formatString: #,##0
		lineageTag: 4905b873-a93d-5a1d-b0db-65f6b94a619d

	measure 'Forecast EBITDA (SAR m)' = SUM(Forecast[EBITDASARm])
		formatString: #,##0;-#,##0
		lineageTag: ce2391a1-1d72-589e-82e7-e2fd28546531

	measure 'Forecast EBITDA Margin' = DIVIDE([Forecast EBITDA (SAR m)], [Forecast Revenue (SAR m)])
		formatString: 0.0%
		lineageTag: 9016e239-f633-56af-a8e2-4d1ae855c312

	measure 'Forecast Capex (SAR m)' = SUM(Forecast[CapexSARm])
		formatString: #,##0
