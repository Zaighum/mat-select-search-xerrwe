		lineageTag: a1121493-3e6f-5292-9f86-85c3af83e496

	measure 'Base 2031 EBITDA (SAR m)' = CALCULATE([Forecast EBITDA (SAR m)], Forecast[Scenario] = "Base", Forecast[Year] = 2031)
